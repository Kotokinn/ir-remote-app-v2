# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored by Next.js by default — safe to put real secrets here.

# Backend base URL — the api-gateway (docker-compose publishes it on 18080) is the single entry point (routes /api/auth,
# /api/smart and /api/mqtt, incl. the device SSE stream). It needs Redis reachable and
# the downstream services (auth 8081, mqtt 8083, smart-iot-app 8086) running behind it.
NEXT_PUBLIC_API_URL=http://localhost:18080

# Google OAuth Client ID — must be type "Desktop app" in Google Cloud Console
# (NOT "Web application" — native apps can't keep a client secret). No redirect
# URI needs registering on the client: the app uses a loopback redirect
# (http://127.0.0.1:<ephemeral port>/callback), which Google accepts on any
# port for Desktop-app clients automatically. Custom URI schemes are NOT an
# option any more — Google blocked them for every native client type in 2022.
# This same value must also be set as GOOGLE_CLIENT_ID on auth-service (env var,
# see security.jwt / google.auth.client-id in its application.yaml) — both sides
# check the same Client ID as the token's audience.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google's docs call this optional for Desktop-app + PKCE, but the real token
# endpoint rejects the exchange without it ("client_secret is missing.").
# Get it from the same Credentials page (click the client, "Client secret").
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=
